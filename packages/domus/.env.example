# Umami analytics (see src/analytics.ts). Copy to `.env.local` for local testing (gitignored),
# or set these in the production build/deploy environment. Tracking only activates in a PROD build
# AND when VITE_UMAMI_WEBSITE_ID is set — so dev and tests stay out of the stats.

# The website's UUID from the Umami dashboard (Websites → your site). Public value (ships in HTML).
VITE_UMAMI_WEBSITE_ID=

# Optional: script origin. Defaults to Umami Cloud. Repoint here if you migrate to self-hosted, e.g.
# VITE_UMAMI_SRC=https://analytics.gamedevfox.org/script.js
VITE_UMAMI_SRC=
